# ==============================================================================
# .editorconfig — Consistent coding style across editors
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{tf,tfvars,tfstate}]
indent_size = 2

[*.{go,mod,sum}]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{yaml,yml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.sh]
indent_style = tab
